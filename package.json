{
  "name": "solar-system-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "Solar System Explorer - an immersive, interactive 3D atlas of our cosmic neighborhood.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "build:vite": "vite build",
    "preview": "vite preview --port 4319",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('node_modules/.vite',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true});console.log('cleared node_modules/.vite and dist')\"",
    "assets:gesture": "node tools/fetch-mediapipe.mjs",
    "test:gesture": "node tools/gesture-selftest.mjs",
    "test:e2e": "node tools/gesture-e2e.mjs",
    "test:mobile": "node tools/gesture-mobile.mjs",
    "test:motion": "node tools/check-reduced-motion.mjs",
    "test:v22": "node tools/verify-v22.mjs",
    "test:v24": "node tools/verify-v24.mjs",
    "test:v25": "node tools/verify-v25.mjs",
    "test:classes": "node tools/check-classes.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.0",
    "vite": "^5.4.11"
  }
}
